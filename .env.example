# Placeholder-only example. Copy to .env.local (ignored by Git) for local use.
# Never commit real values. Production values belong in the hosting secret manager.
# Variables prefixed NEXT_PUBLIC_ are sent to browsers; never put a secret in one.

# --- Application -------------------------------------------------------------
# Canonical origin used for exact Origin/CSRF checks. HTTPS is required in production.
APP_ORIGIN=http://localhost:3000
LOG_LEVEL=info
# Explicit trusted proxy/source-IP interpretation. Leave unset until the hosting topology is approved.
TRUSTED_PROXY_CONFIG=

# --- Supabase (public; safe for browsers only because RLS and grants protect data) ---
# Local stack default is http://127.0.0.1:54321. Use the project's publishable (or legacy anon) key.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# --- Server-only secrets (never browser-visible) -----------------------------
# Privileged Auth provisioning credential. Not for ballots, results or exports.
SUPABASE_SERVICE_ROLE_KEY=
# Versioned key for supplemental application rate-limit digests (at least 32 characters).
RATE_LIMIT_HMAC_KEY=

# --- Deployment-only secrets (not read by the running application) -----------
# Supabase CLI management token and direct migration connection, if the workflow needs them.
SUPABASE_ACCESS_TOKEN=
MIGRATION_DATABASE_URL=

# SMTP, OTP template/expiry/limits, allowed Auth URLs and Cron jobs are configured in
# Supabase/provider settings and reviewed migrations, not in application variables.
