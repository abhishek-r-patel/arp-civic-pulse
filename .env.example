# Placeholder-only example. Copy to .env.local (ignored by Git) for local use.
# Never commit real values. Production values belong in the hosting secret manager.
# Variables prefixed NEXT_PUBLIC_ are sent to browsers; never put a secret in one.

# --- Application -------------------------------------------------------------
# Canonical origin used for exact Origin/CSRF checks. HTTPS is required in production.
APP_ORIGIN=http://localhost:3000
LOG_LEVEL=info
# Production requires the Vercel ingress. Its overwritten X-Forwarded-For header
# is used only for OTP budgets; local development may leave this blank.
TRUSTED_PROXY_CONFIG=

# --- Optional SaaS tenant routing (off by default) -----------------------------
# Only the separate tenant-test Vercel project enables it (synthetic hosts). Keep
# false for real customers until the actual domain and production gates close.
# Limits: 1 main, 1 demo and at most 10 customer hosts. No sample directory here.
TENANT_ROUTING_ENABLED=false
TENANT_DIRECTORY_JSON=
# Referenced credentials use one variable per immutable tenant UUID:
# TENANT_<UUID32>_SUPABASE_SERVICE_ROLE_KEY=

# --- Supabase (public; safe for browsers only because RLS and grants protect data) ---
# Local stack default is http://127.0.0.1:54321. Use the project's publishable (or legacy anon) key.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# --- Optional second disposable project for cross-tenant live tests -----------
# Read only by the paired test in tests/live/auth.live.test.ts, which accepts
# exactly the staging project as A and the demo project hnqajjjemqepxuoqbsqx as
# B (the free tier allows only two projects). Never use the same project as
# NEXT_PUBLIC_SUPABASE_URL or production. The test leaves Auth users/profiles in
# both projects, so `npm run test:live` runs `npm run demo:reset` afterwards
# (needs .env.demo.local); never run it during a demo. Leave these empty to
# skip the paired test.
TENANT_TEST_SUPABASE_URL=
TENANT_TEST_SUPABASE_PUBLISHABLE_KEY=
TENANT_TEST_SUPABASE_SERVICE_ROLE_KEY=
# Include sslrootcert=<URL-encoded path> if this project's approved CA differs
# from PGSSLROOTCERT. Never disable certificate or hostname verification.
TENANT_TEST_DATABASE_URL=

# --- Server-only secrets (never browser-visible) -----------------------------
# Privileged Auth provisioning credential. Not for ballots, results or exports.
SUPABASE_SERVICE_ROLE_KEY=
# Versioned key for supplemental application rate-limit digests (at least 32 characters).
RATE_LIMIT_HMAC_KEY=
# Developer/support contact for RWA-controlled "App Support Access" (server-only; never
# browser-visible). Setting this does NOT grant access by itself: an enabled RWA admin must
# turn access on from Settings, and can turn it off at any time. When on, this identity signs
# in through the normal email OTP flow with household-free, read-only (rwa-readonly) access.
APP_SUPPORT_EMAIL=

# --- Deployment-only secrets (not read by the running application) -----------
# Supabase CLI management token and direct migration connection, if the workflow needs them.
SUPABASE_ACCESS_TOKEN=
MIGRATION_DATABASE_URL=
# Required by the read-only migration-status check; must match its database URL.
MIGRATION_PROJECT_REF=

# SMTP, OTP template/expiry/limits, allowed Auth URLs and Cron jobs are configured in
# Supabase/provider settings and reviewed migrations, not in application variables.

# --- Public launch integrations (optional; disabled when blank) ----------------
# Resend is for contact enquiries only, never OTPs or ballot notifications.
# Set all three together. FROM must be a bare address on a verified sender domain.
RESEND_API_KEY=
CONTACT_EMAIL_FROM=
CONTACT_EMAIL_TO=
# Public enquiry address shown (as a mail link) on the product website's Contact
# page only. Without it that page says enquiries are not open yet.
SALES_CONTACT_EMAIL=
# Public identifiers, not secrets. Set at build AND runtime; rebuild after changes.
# GA4 enhanced measurement must be disabled; public information pages are opt-in only.
GOOGLE_ANALYTICS_ID=
# HTML-tag verification token only (not the full Google meta tag).
GOOGLE_SITE_VERIFICATION=
# Sentry error monitoring and sampled tracing (see docs/OPERATIONS.md). The DSN is a
# public identifier. Set it for Vercel Production and Preview only; Sentry stays off
# in local/development builds even when set. Rebuild after changes.
NEXT_PUBLIC_SENTRY_DSN=
# Build-only source-map upload settings. SENTRY_AUTH_TOKEN is a secret: Vercel
# build environment only, never NEXT_PUBLIC_. Without it, no source maps are emitted.
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=

# --- Operations (see docs/OPERATIONS.md) ---------------------------------------------
# Local read-only configuration report only; requires approved operator database access.
# Not a public route, app login bypass or application runtime credential.
CONFIG_DATABASE_URL=
# Set to 1 to stop serving the app while data is restored or reconciled (pages and API answer 503).
MAINTENANCE_MODE=
# Set to 0 to switch the PDF download off. On by default.
PDF_EXPORT_ENABLED=
# Backup tooling only (not read by the running app): a direct DB connection for a dedicated backup login,
# a 64-hex-character encryption key from your secret store, and the off-site destination folder.
# Remote PostgreSQL URLs require sslmode=verify-full (also the remote default).
# Supply the provider CA through sslrootcert or PGSSLROOTCERT when needed; never disable TLS.
BACKUP_DATABASE_URL=
BACKUP_ENCRYPTION_KEY=
BACKUP_DIR=
BACKUP_MAX_AGE_HOURS=
# An isolated, already-migrated database for restore rehearsals. Never the live one.
RESTORE_DATABASE_URL=
# Demo project only: put these in a separate `.env.demo.local` (ignored by Git),
# not in .env.local. Only `npm run ops` and `npm run demo:reset` load that file;
# the app, Playwright and live tests never read it. It is the DEDICATED demo
# project, which `demo:reset` erases and reseeds.
DEMO_PROJECT_REF=
DEMO_SUPABASE_URL=
DEMO_SERVICE_ROLE_KEY=
DEMO_DATABASE_URL=
# Optional in .env.demo.local: PGSSLROOTCERT=.certs/supabase-db-ca.crt (repo-relative).
# `npm run ops -- provision` only: one FRESH customer project. Set per run, then unset.
# SUPABASE_ACCESS_TOKEN (above) lets it apply and verify the Auth settings.
PROVISION_PROJECT_REF=
PROVISION_SUPABASE_URL=
PROVISION_SERVICE_ROLE_KEY=
PROVISION_DATABASE_URL=
PROVISION_PUBLISHABLE_KEY=
PROVISION_ADMIN_EMAIL=
