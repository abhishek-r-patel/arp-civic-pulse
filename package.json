{
  "name": "arp-civic-pulse",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Civic Pulse: mobile-first voting and polls for a single RWA",
  "engines": {
    "node": ">=24 <25",
    "npm": ">=10"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "deploy:check": "node --conditions=react-server scripts/deploy/check.ts",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "test:load": "vitest run --config vitest.load.config.ts",
    "test:live": "vitest run --config vitest.live.config.ts",
    "test:e2e": "playwright test",
    "ops": "node --env-file-if-exists=.env.local scripts/ops/cli.ts"
  },
  "dependencies": {
    "@supabase/ssr": "0.12.7",
    "@supabase/supabase-js": "2.118.0",
    "fontkit": "2.0.4",
    "lucide-react": "1.61.0",
    "next": "16.4.3",
    "pdfkit": "0.20.2",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "server-only": "0.0.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@playwright/test": "1.64.1",
    "@tailwindcss/postcss": "4.3.3",
    "@types/fontkit": "2.0.9",
    "@types/node": "24.19.2",
    "@types/pdfkit": "0.17.7",
    "@types/pg": "8.23.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.3",
    "pdfjs-dist": "6.4.299",
    "pg": "8.23.1",
    "postcss": "8.5.31",
    "prettier": "3.9.10",
    "prettier-plugin-tailwindcss": "0.8.1",
    "tailwindcss": "4.3.3",
    "typescript": "6.0.3",
    "vitest": "5.0.5"
  }
}
