{
  "name": "arp-civic-pulse",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Civic Pulse: mobile-first voting and polls for a single RWA",
  "engines": {
    "node": ">=24 <25",
    "npm": ">=10"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "deploy:check": "node --conditions=react-server scripts/deploy/check.ts",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "test:load": "vitest run --config vitest.load.config.ts",
    "test:live": "node scripts/test/live.mjs",
    "test:target": "node --use-system-ca scripts/ops/test-target.ts",
    "testdb:pause": "node --use-system-ca scripts/ops/test-target.ts pause-testdb",
    "testdb:resume": "node --use-system-ca scripts/ops/test-target.ts resume-testdb",
    "society:create": "node --use-system-ca scripts/ops/create-society.ts",
    "society:delete": "node --use-system-ca scripts/ops/delete-society.ts",
    "vercel:directory": "node --use-system-ca scripts/ops/vercel-directory.ts",
    "test:e2e": "playwright test",
    "ops": "node --conditions=react-server --env-file-if-exists=.env.local --env-file-if-exists=.env.demo.local scripts/ops/cli.ts",
    "demo:reset": "node --use-system-ca --conditions=react-server --env-file-if-exists=.env.local --env-file-if-exists=.env.demo.local scripts/ops/cli.ts demo-reset --confirm arxkuxlbynjbqcjuugde"
  },
  "dependencies": {
    "@sentry/nextjs": "11.11.0",
    "@supabase/ssr": "0.12.7",
    "@supabase/supabase-js": "2.119.0",
    "csv-parse": "7.0.3",
    "fontkit": "2.0.4",
    "lucide-react": "1.70.0",
    "next": "16.4.5",
    "next-themes": "0.4.6",
    "pdfkit": "0.20.2",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "server-only": "0.0.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@playwright/test": "1.65.0",
    "@tailwindcss/postcss": "4.3.4",
    "@types/fontkit": "2.0.9",
    "@types/node": "26.6.6",
    "@types/pdfkit": "0.17.7",
    "@types/pg": "8.23.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "10.14.0",
    "eslint-config-next": "16.4.5",
    "pdfjs-dist": "6.5.438",
    "pg": "8.23.1",
    "postcss": "8.5.32",
    "prettier": "3.9.10",
    "prettier-plugin-tailwindcss": "0.8.1",
    "tailwindcss": "4.3.4",
    "typescript": "6.0.3",
    "vitest": "5.1.0"
  },
  "overrides": {
    "typescript": "$typescript",
    "@sentry/bundler-plugins": {
      "glob": "14.0.2"
    },
    "minimatch": "11.0.1"
  }
}
